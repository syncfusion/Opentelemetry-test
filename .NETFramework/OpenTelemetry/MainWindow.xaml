<Window x:Class="OpenTelemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenTelemetry"
        mc:Ignorable="d"
        xmlns:viewmodel="clr-namespace:OpenTelemetry.ViewModel"
        xmlns:syncfusion1="clr-namespace:Syncfusion.UI.Xaml.Chat;assembly=Syncfusion.SfChat.Wpf"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <viewmodel:ConversationHistoryViewModel/>
    </Window.DataContext>

    <Grid>
        <syncfusion1:SfAIAssistView
                x:Name="Chat"
                Grid.Row="1"
                Suggestions="{Binding Suggestion}"
                Conversations="{Binding Conversations}"                    
                NavigationHeader="Sync AI Assist"
                ShowNavigationView="True"     
                ShowTypingIndicator="{Binding ShowTypingIndicator}"           
                PromptRequest="Chat_PromptRequest"
                CurrentUser="{Binding CurrentUser}"
                Messages="{Binding Chats}"
                >
        </syncfusion1:SfAIAssistView>
    </Grid>
</Window>
